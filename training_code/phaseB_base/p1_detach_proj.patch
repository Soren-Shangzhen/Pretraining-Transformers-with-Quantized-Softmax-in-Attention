+#!/usr/bin/env bash
+set -euo pipefail
+
+# P1 causal ablation: same 100M LR schedule / seed / checkpointing protocol as
+# the completed q32_lerp_100m (detach) and q32_lerp_fullgrad_100m (full) runs.
+
+RUN="q32_lerp_detachproj_100m"
+
+if [[ -e "runs/${RUN}/log.csv" || -e "runs/${RUN}/ckpt.pt" ]]; then
+    echo "ERROR: runs/${RUN} already contains run state."
+    echo "Refusing to overwrite. Inspect it or choose a deliberate recovery action."
+    exit 2
+fi
+
+mkdir -p terminal_logs
+
+python train.py \
+  --run_name "${RUN}" \
+  --data_dir data/wikitext103 \
+  --attn quant \
+  --K 32 \
+  --approx lerp \
+  --range_grad detach_proj \
+  --micro_batch 1 \
+  --batch_tokens 131072 \
+  --max_tokens 100000000 \
+  --warmup_tokens 10000000 \
+  --eval_every_tokens 5000000 \
+  --eval_batches 100 \
+  --stats_batches 1 \
+  --ckpt_every_tokens 20000000 \
+  --grad_checkpointing \
+  --device cuda \
+  --seed 1337 \
+  2>&1 | tee "terminal_logs/${RUN}.log"
